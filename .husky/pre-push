#!/bin/sh
# ==========================================================
# Husky pre-push hook
# Runs your full quality pipeline before allowing a push.
# ==========================================================

echo "🚀 Running full quality checks before push..."

# Run the same check pipeline you have defined in package.json
npm run check

# If the previous command fails, cancel the push
if [ $? -ne 0 ]; then
  echo "❌ Push blocked due to failing checks."
  exit 1
fi

echo "✅ All checks passed — proceeding with push!"