# Copy to .env and fill in locally. Never commit .env.

# Core
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=

# Admin API / dashboards
ADMIN_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHODS=card

# Alerting
ALERT_EMAIL_TO=
ALERT_HEARTBEAT_MINUTES=60

# Supplier auto-publish
AUTO_PUBLISH_MIN_SCORE=

# Abandoned-cart recovery job
DRY_RUN=true
NUDGE_1_DAYS=1
NUDGE_2_DAYS=3
RECOVERY_MAX_AGE_DAYS=30
