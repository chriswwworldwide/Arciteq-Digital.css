// eslint.config.js
import js from "@eslint/js";
import globals from "globals";

export default [
  js.configs.recommended,
  {
    files: ["**/*.js"],
    ignores: [
      // ⛔ files ESLint should completely skip
      "node_modules/**",
      "dist/**",
      "public_backup_*/**",
      "backups_*/**",
      "themes/**",
      "public/**",
      "**/*.min.js",
      "**/*.bundle.js",
      "package*.json"
    ],
    languageOptions: {
      ecmaVersion: 2022,
      sourceType: "module",
      globals: {
        ...globals.browser,
        ...globals.node
      }
    },
    rules: {
      "no-undef": "off",
      "no-unused-vars": "warn",
      // 👇 disables the whitespace noise completely
      "no-irregular-whitespace": "off",
      semi: ["warn", "always"]
    }
  }
];